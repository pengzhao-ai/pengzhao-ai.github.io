---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import PublicationList from '~/components/portfolio/PublicationList.astro';
import { PUBLICATIONS, PUBLICATION_METRICS } from '~/data/publications';
import { HEADLINE_METRICS } from '~/data/metrics';

const metadata = {
  title: 'Publications',
  description: 'Peer-reviewed papers, refereed proceedings, and patents in optics, imaging, and hardware systems.',
};

const stats = HEADLINE_METRICS;

const journals = PUBLICATIONS.filter((p) => p.type === 'journal').sort((a, b) => b.year - a.year);
const conferences = PUBLICATIONS.filter((p) => p.type === 'conference').sort((a, b) => b.year - a.year);
const patents = PUBLICATIONS.filter((p) => p.type === 'patent').sort((a, b) => b.year - a.year);

// Assembled here so Prettier line-wrapping can never drop the space between
// the count and the noun in the rendered HTML.
const countLabel = (n: number) => `${n} ${n === 1 ? 'entry' : 'entries'}`;
---

<Layout metadata={metadata}>
  <WidgetWrapper containerClass="max-w-5xl mx-auto pt-12 md:pt-16">
    <div class="panel mb-6">
      <Headline
        level={1}
        tagline="Publications"
        title="Papers and patents"
        subtitle={PUBLICATION_METRICS.summary}
        classes={{ container: 'max-w-3xl', title: 'text-4xl md:text-5xl ', subtitle: 'text-lg' }}
      />

      <dl
        class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-slate-200 bg-slate-200 md:grid-cols-4 dark:border-slate-800 dark:bg-slate-800"
      >
        {
          stats.map((stat) => (
            <div class="bg-page px-5 py-4">
              <dt class="font-mono text-xs uppercase tracking-wider text-muted">{stat.label}</dt>
              <dd class="mt-1 font-heading text-3xl font-semibold text-heading">{stat.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 text-center font-mono text-xs text-muted">{PUBLICATION_METRICS.citations}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <Button
          variant="secondary"
          text="Profile on Google Scholar"
          href={PUBLICATION_METRICS.scholarUrl}
          target="_blank"
          icon="tabler:external-link"
        />
        <Button
          variant="secondary"
          text="ORCID record"
          href={PUBLICATION_METRICS.orcidUrl}
          target="_blank"
          icon="tabler:external-link"
        />
      </div>
    </div>

    <section class="panel mb-6" data-publication-section="journal-articles">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Journal articles</h2>
        <span class="font-mono text-xs text-muted">{countLabel(journals.length)}</span>
      </div>
      <PublicationList items={journals} variant="full" />
    </section>

    <section class="panel mb-6" data-publication-section="conference-papers">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Conference papers</h2>
        <span class="font-mono text-xs text-muted">{countLabel(conferences.length)}</span>
      </div>
      <PublicationList items={conferences} variant="full" />
    </section>

    <section class="panel mb-6" data-publication-section="patents">
      <div class="mb-6 flex items-baseline justify-between gap-4">
        <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">Patents</h2>
        <span class="font-mono text-xs text-muted">{countLabel(patents.length)}</span>
      </div>
      <PublicationList items={patents} variant="full" />
    </section>

    <div class="panel text-center">
      <p class="text-muted">
        The publication summary, citation figures, and patent details come verbatim from my résumé. Papers — titles,
        venues, years, and DOIs — are transcribed from my ORCID record; the Google Scholar profile stays the citation
        record.
      </p>
    </div>
  </WidgetWrapper>
</Layout>
