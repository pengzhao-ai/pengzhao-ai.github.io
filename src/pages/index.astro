---
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import PublicationList from '~/components/portfolio/PublicationList.astro';
import SocialLinks from '~/components/portfolio/SocialLinks.astro';
import ToolboxGrid from '~/components/portfolio/ToolboxGrid.astro';
import { PUBLICATIONS, PUBLICATION_METRICS } from '~/data/publications';
import { TOOLBOX } from '~/data/toolbox';
import { getPermalink } from '~/utils/permalinks';
import profile from '~/assets/images/profile.jpg';

const metadata = {
  title: 'Peng Zhao — Optical Systems, Imaging, and Edge AI',
  ignoreTitleTemplate: true,
};

const patentPublications = PUBLICATIONS.filter((publication) => publication.type === 'patent').sort(
  (a, b) => b.year - a.year
);

// The toolbox panel highlights the entries flagged for the home page; the full
// category list lives on /toolbox.
const featuredToolbox = TOOLBOX.filter((entry) => entry.featured);
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 md:pt-10">
    <div class="panel">
      <div class="grid items-center gap-8 md:grid-cols-[13rem_1fr] lg:grid-cols-[15rem_1fr] lg:gap-14">
        <div class="mx-auto w-44 sm:w-52 md:mx-0 md:w-full">
          <Image
            class="w-full rounded-2xl"
            widths={[320, 480, 640]}
            sizes="(max-width: 767px) 208px, (max-width: 1023px) 240px, 280px"
            width={profile.width}
            height={profile.height}
            layout="constrained"
            format="webp"
            src={profile}
            alt="Peng Zhao"
          />
        </div>
        <div class="text-center md:text-left">
          <span
            class="inline-block rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/25 dark:text-blue-200"
          >
            Optical Systems · Imaging · Edge AI
          </span>
          <h1 class="mt-4 font-heading text-4xl font-bold tracking-tighter text-heading md:text-5xl lg:text-6xl">
            Peng Zhao
          </h1>
          <p class="mt-3 text-lg font-semibold text-secondary dark:text-blue-200">
            Hardware and AI, from concept to production
          </p>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-muted text-pretty dark:text-slate-300 md:mx-0">
            I'm an engineer fascinated by how devices perceive and interact with the physical world. Following my Ph.D.
            in Optics and Photonics from CREOL, my journey has centered on leading sensing engineering initiatives
            across ASML, Apple, and Meta, taking complex optical architectures from concept all the way to mass
            production. Lately, I'm focused on pushing the frontier where smart hardware products interface with AI 🚀.
          </p>
          <p class="mx-auto mt-4 max-w-2xl text-lg text-muted text-pretty dark:text-slate-300 md:mx-0">
            In my free time, I love getting outside for sports (🎾, 🏊‍♂️, 🏄‍♂️, 🥾) and exploring photography 📸. I'm also
            big on traveling, teaching, and connecting with new people.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:justify-center md:justify-start">
            <a href={getPermalink('/toolbox')} class="btn-primary">View toolbox</a>
            <a href={getPermalink('/cv')} class="btn-secondary">View CV</a>
          </div>
        </div>
      </div>

      <div class="mt-8 border-t border-slate-200/80 pt-6 dark:border-slate-700/50">
        <SocialLinks class="justify-center md:justify-start" />
      </div>
    </div>
  </section>

  <WidgetWrapper containerClass="max-w-7xl mx-auto">
    <div class="panel">
      <Headline
        tagline="Toolbox"
        title="Open code, one repo at a time"
        subtitle="Open tools from my own work — optical simulation, imaging pipelines, and AI at the edge, each published with the write-up that explains how it works."
        classes={{ container: 'max-w-3xl' }}
      />
      {featuredToolbox.length > 0 && <ToolboxGrid items={featuredToolbox} variant="featured" />}
      <div class="mt-10 text-center">
        <a href={getPermalink('/toolbox')} class="btn-secondary"> Open the toolbox </a>
      </div>
    </div>
  </WidgetWrapper>

  <WidgetWrapper containerClass="max-w-4xl mx-auto">
    <div class="panel">
      <Headline tagline="Publications" title="Papers and patents" classes={{ container: 'max-w-3xl' }} />
      <h3 class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">Publications</h3>
      <p class="text-sm text-muted">{PUBLICATION_METRICS.summary}</p>
      <div class="my-8 border-t border-slate-200/80 dark:border-slate-700/50"></div>
      <h3 class="mb-6 font-mono text-xs uppercase tracking-[0.2em] text-muted">Patents</h3>
      <PublicationList items={patentPublications} variant="compact" />
      <div class="mt-10 text-center">
        <a href={getPermalink('/publications')} class="btn-secondary"> All publications </a>
      </div>
    </div>
  </WidgetWrapper>

  <BlogLatestPosts
    featured
    title="Writing"
    linkText="All posts"
    information="Notes on optical design, hardware that has to ship, and where AI genuinely helps."
    count={3}
  />

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Get in touch', href: `mailto:${'peng.zhao1@outlook.com'}`, icon: 'tabler:mail' },
      { text: 'View CV', href: getPermalink('/cv'), icon: 'tabler:file-text' },
    ]}
  >
    <Fragment slot="title">Let's build something that ships.</Fragment>
    <Fragment slot="subtitle">
      I'm interested in optical and sensing systems where the hard part is making the physics survive production.
    </Fragment>
  </CallToAction>
</Layout>
