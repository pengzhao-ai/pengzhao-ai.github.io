---
import { Icon } from 'astro-icon/components';
import { APP_BLOG } from 'astrowind:config';
import type { ImageMetadata } from 'astro';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import type { Post } from '~/types';

export interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
const links = posts.map((post) => (APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : ''));
const images = (await Promise.all(posts.map((post) => findImage(post.image)))) as Array<
  ImageMetadata | string | undefined
>;
---

{
  posts.length > 0 && (
    <ul class="mt-8 divide-y divide-slate-200/80 border-t border-slate-200/80 dark:divide-slate-700/40 dark:border-slate-700/40">
      {posts.map((post, index) => (
        <li>
          <a href={links[index] || undefined} class="group flex items-center gap-4 py-4">
            {images[index] && (
              <Image
                src={images[index]}
                class="h-auto w-20 shrink-0 rounded-md object-cover sm:w-24"
                widths={[96, 160]}
                width={160}
                height={90}
                sizes="96px"
                alt={post.imageAlt || post.title}
                format="webp"
                loading="lazy"
                decoding="async"
              />
            )}
            <div class="min-w-0 flex-1">
              <p class="font-heading text-base font-semibold leading-snug text-heading group-hover:text-primary sm:text-lg">
                {post.title}
              </p>
              <p class="mt-1 text-xs text-muted">
                <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
                {post.category && <> · {post.category.title}</>}
                {post.readingTime && <> · {post.readingTime} min read</>}
              </p>
            </div>
            <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0 text-muted transition group-hover:text-primary" />
          </a>
        </li>
      ))}
    </ul>
  )
}
